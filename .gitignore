/target
**/*.rs.bk
# Local lab evidence never enters the repository (section 6.3).
/lab/
*.apk
*.dex
*.odex
*.vdex
*.redb
*.redb.lock
.env
.env.*
!.env.example
*.key
*.pem
*.log
.DS_Store
Thumbs.db
# Saved agent transcripts contain private numbers and credentials.
/codex-session-*.md
.claude/worktrees/

# Seeder is local by default. Track only its sanitized infrastructure evidence
# and reproducible configuration; credentials and other local payloads remain
# ignored.
Seeder/*
!Seeder/docs/
!Seeder/docs/**
!Seeder/infra/
!Seeder/infra/**
